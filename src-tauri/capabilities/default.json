{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and video player windows",
  "windows": ["main", "video-player-*"],
  "permissions": [
    "core:default",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:webview:allow-create-webview-window",
    
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file"
  ]
}